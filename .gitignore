.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Whether you use PnP or not, the node_modules folder is often used to store
# build artifacts that should be gitignored
node_modules

# Swap the comments on the following lines if you wish to use zero-installs
# In that case, don't forget to run `yarn config set enableGlobalCache false`!
# Documentation here: https://yarnpkg.com/features/caching#zero-installs

#!.yarn/cache
.pnp.*

# Приватный ключ самоподписанного сертификата: генерируется при `yarn start`
certs/

# Артефакты e2e-прогона
results/*.png

# Сборка сайта документации (MkDocs)
site/
# Сборка Sphinx (используется в задании T1, каталог задаётся аргументом -b)
_build/
# Кэш переводов и данных, который создают Quarto и Sphinx
.quarto/

# Локальное окружение Python для сборки сайта
.venv-docs/

# Кэш байт-кода Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Служебные файлы macOS
.DS_Store
