%% Архитектура экспериментального стенда rtc-benchmark (ПР-3, раздел 5.1).
%% Топология experiment/compose-router.yml: эмуляция сети вынесена в отдельный
%% контейнер-маршрутизатор, чтобы потери и задержка не вносились на конечных
%% узлах (см. Kakhki et al., IMC'17). Рендер: https://mermaid.live или любой
%% просмотрщик Markdown с поддержкой Mermaid.
flowchart LR
  subgraph Bench["bench (cpus 4, 3 ГБ)"]
    direction TB
    ORCH["run-plan.mjs<br/>план, сид, рандомизация,<br/>калибровка"]
    SERIES["run-series.mjs<br/>прогон = свежий браузер,<br/>монитор CPU"]
    CHR["headless Chromium 156<br/>bench.ts, BenchChannel × 4"]
    ORCH --> SERIES --> CHR
  end
  subgraph Router["router (cpus 1)"]
    direction TB
    AGENT["netem-agent.mjs"]
    NETEM(("tc netem<br/>оба интерфейса"))
    AGENT --> NETEM
  end
  subgraph Server["server (cpus 2, 1 ГБ)"]
    direction TB
    SIG["HTTP :8080<br/>сигналинг, /api/metrics"]
    WT["WebTransport echo<br/>quiche"]
    RTC["WebRTC echo<br/>node-datachannel"]
    UDP["UDP-эхо<br/>калибровка"]
  end
  ORCH -->|"профиль"| AGENT
  CHR -->|"UDP: QUIC, DTLS/SCTP"| NETEM
  NETEM --> SIG
  NETEM --> WT
  NETEM --> RTC
  NETEM --> UDP

  SERIES -->|"JSON + манифест"| RAW[("results/план/raw")]
  RAW --> AN["analyze.mjs<br/>бутстреп-ДИ, Манн–Уитни,<br/>Холм, A/A"]
  AN --> CMP["compare.mjs<br/>сверка с эталоном"]
